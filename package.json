{
  "name": "grok-pattern-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Write, test and benchmark grok and Logstash patterns online with field inference, ReDoS warnings and exports for Vector and Fluent Bit.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @grokparse/web dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @grokparse/web test:e2e",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0"
}
